{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/buen-fin-2026",
      "destination": "https://www.taanahglamping.com/eventos",
      "permanent": true
    },
    {
      "source": "/buen-fin-2026.html",
      "destination": "https://www.taanahglamping.com/eventos",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "taanahglamping.com"
        }
      ],
      "destination": "https://www.taanahglamping.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
